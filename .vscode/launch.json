{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rover: webcam detection",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Rover: check imports",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_install.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Rover: check model without webcam",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_install.py",
      "args": ["--inference"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {"python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
